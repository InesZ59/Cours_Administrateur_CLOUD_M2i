{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LireLesFichiersImportes",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET/imports/*"
    },
    {
      "Sid": "EcrireLesCommandes",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:BatchWriteItem"],
      "Resource": "arn:aws:dynamodb:REGION:COMPTE:table/demo-commandes"
    }
  ]
}
