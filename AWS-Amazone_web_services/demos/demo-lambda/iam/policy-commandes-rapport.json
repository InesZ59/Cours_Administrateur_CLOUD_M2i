{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LireLesCommandes",
      "Effect": "Allow",
      "Action": "dynamodb:Scan",
      "Resource": "arn:aws:dynamodb:REGION:COMPTE:table/demo-commandes"
    },
    {
      "Sid": "EcrireLesRapports",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::BUCKET/rapports/*"
    }
  ]
}
