# Configuration de la pile Compose StockLine.
# Copiez ce fichier vers `.env` (docker compose le lit automatiquement) :
#   cp .env.example .env
# puis remplacez le mot de passe. Le fichier .env ne se commite JAMAIS.

POSTGRES_USER=stockline
POSTGRES_PASSWORD=changez-moi-avant-le-premier-up
POSTGRES_DB=stockline
